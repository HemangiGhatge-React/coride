generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // null for accounts created via Vipps Login
  vippsSub  String?  @unique // stable Vipps Login subject identifier
  name      String
  role      Role     @default(DRIVER)
  createdAt DateTime @default(now())

  vehicles      Vehicle[]
  rides         Ride[]         @relation("DriverRides")
  bookings      Booking[]
  refreshTokens RefreshToken[]
}

// Opaque refresh tokens, stored hashed. Rotated on every use; all tokens from
// one login share a familyId so reuse of a rotated token revokes the session.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}

enum Role {
  DRIVER
  ADMIN
}

model Vehicle {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])
  make    String
  model   String
  plate   String
  seats   Int

  rides Ride[]
}

model Ride {
  id             String     @id @default(uuid())
  driverId       String
  driver         User       @relation("DriverRides", fields: [driverId], references: [id])
  vehicleId      String
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id])
  origin         String
  destination    String
  departureTime  DateTime
  seatsTotal     Int
  // Enforced by CHECK constraints Ride_seatsAvailable_nonnegative and Ride_seatsAvailable_lte_seatsTotal (migration 20261008104552_ride_seats_check)
  seatsAvailable Int
  totalFuelCost  Decimal    @db.Decimal(10, 2)
  costPerSeat    Decimal    @db.Decimal(10, 2)
  status         RideStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())

  bookings Booking[]
}

enum RideStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

model Booking {
  id            String        @id @default(uuid())
  rideId        String
  ride          Ride          @relation(fields: [rideId], references: [id])
  riderId       String
  rider         User          @relation(fields: [riderId], references: [id])
  seatsBooked   Int           @default(1)
  paymentStatus PaymentStatus @default(MOCK_UNPAID)
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now())

  @@unique([rideId, riderId])
}

enum PaymentStatus {
  MOCK_UNPAID
  MOCK_PAID
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}
