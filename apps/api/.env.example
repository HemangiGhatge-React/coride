# Copy to .env and fill in. Placeholders only; never commit real values.

# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Direct (non-pooled) connection, used for prisma migrate.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT-HOST/DBNAME?sslmode=require

JWT_SECRET=change-me

# Browser origins allowed to call the API (comma-separated, exact origins, no trailing slash).
# Leave empty to refuse all cross-origin browser requests. Mobile is not affected by CORS.
CORS_ORIGINS=http://localhost:3000

# Path the httpOnly refresh cookie is scoped to. Default /auth. If the API is exposed behind a
# prefix (for example a web proxy serving it under /api), set it to match, e.g. /api/auth.
# REFRESH_COOKIE_PATH=/auth

# Used only by the e2e tests (test/load-test-env.ts): hostname of the main database, so the tests
# refuse to run against it when there is no apps/api/.env (for example in CI).
# MAIN_DB_HOST=

# Vipps Login (dormant; leave unset until credentials exist)
# VIPPS_CLIENT_ID=
# VIPPS_CLIENT_SECRET=
# VIPPS_MERCHANT_SERIAL_NUMBER=
# VIPPS_REDIRECT_URI=
# VIPPS_APP_REDIRECT_URIS=
